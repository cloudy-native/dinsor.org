---
import { Image } from "astro:assets";
import type { Portfolio } from "../data/portfolios";

interface Props {
	portfolio: Portfolio;
}

const { portfolio } = Astro.props;
const host = portfolio.url.replace(/^https?:\/\//, "");
---

<a
	class="demo-card"
	href={portfolio.url}
	target="_blank"
	rel="noopener noreferrer"
>
	<div class="shot">
		<Image
			src={portfolio.image}
			alt={portfolio.title}
			width={640}
			height={400}
			widths={[320, 640, 960]}
			sizes="(min-width: 768px) 25vw, (min-width: 480px) 50vw, 100vw"
			fit="cover"
			position="top"
			format="webp"
			loading="lazy"
		/>
	</div>
	<p class="demo-title">{portfolio.title}</p>
	<p class="demo-desc">{host}. {portfolio.description}</p>
</a>
