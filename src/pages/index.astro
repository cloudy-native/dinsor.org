---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import PortfolioCard from "../components/PortfolioCard.astro";
import { galleryPortfolios, portfolios } from "../data/portfolios";
import ir from "../../content.json";

const { content } = ir;
const title = "Dinsor · Art and science share a bench";
const description =
	"Studio of Dinsor (Stephen Harrison) in Bangkok. Photography, furniture, and open source tools.";
---

<Layout title={title} description={description}>
	<header class="hero">
		<Navbar />
		<h1>{content.product_name}</h1>
		<p class="tagline">{content.tagline}</p>
		<div class="hero-tokens">
			<span>Open source</span>
			<span>Hand-built</span>
			<span>Free to use</span>
		</div>
	</header>

	<section>
		<div class="section-head">
			<p class="section-num">00 · See it</p>
			<h2 class="section-title">Shipped sites</h2>
			<p class="section-lede">Real screens. Four of them, rotating.</p>
		</div>
		<div class="gallery" data-gallery>
			<div class="gallery-frame" aria-live="polite">
				{
					galleryPortfolios.map((portfolio, i) => (
						<figure
							class:list={["gallery-panel", i === 0 && "is-active"]}
							data-title={portfolio.title}
							data-line={portfolio.galleryCaption}
							aria-hidden={i === 0 ? "false" : "true"}
						>
							<img
								src={portfolio.image}
								alt={portfolio.title}
								loading={i === 0 ? "eager" : "lazy"}
								decoding="async"
							/>
						</figure>
					))
				}
			</div>
			<div class="gallery-caption">
				<p class="title" data-gallery-title></p>
				<p class="line" data-gallery-line></p>
			</div>
			<div class="gallery-tabs" aria-label="Choose a screenshot">
				{
					galleryPortfolios.map((portfolio, i) => (
						<button
							type="button"
							class:list={[i === 0 && "is-active"]}
							aria-pressed={i === 0 ? "true" : "false"}
						>
							{portfolio.title}
						</button>
					))
				}
			</div>
		</div>
	</section>

	<section id="works">
		<div class="section-head">
			<p class="section-num">01 · Selected works</p>
			<h2 class="section-title">The rest of the bench</h2>
			<p class="section-lede">Every public site, in one grid.</p>
		</div>
		<div class="demo-grid">
			{portfolios.map((portfolio) => <PortfolioCard portfolio={portfolio} />)}
		</div>
	</section>

	<section>
		<div class="section-head">
			<p class="section-num">02 · Practice</p>
			<h2 class="section-title">What the work is</h2>
		</div>
		<ol class="features">
			{
				content.features.map((feature) => (
					<li>
						<p class="name">
							{feature.name}
							<small>{feature.subtitle}</small>
						</p>
						<p class="what">{feature.description}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section>
		<div class="section-head">
			<p class="section-num">03 · Principles</p>
			<h2 class="section-title">How it gets built</h2>
		</div>
		<ol class="principles">
			{
				content.principles.map((principle, i) => (
					<li>
						<span class="n">{i + 1}</span>
						<span class="body">
							<b>{principle.title}</b>
							<span>{principle.description}</span>
						</span>
					</li>
				))
			}
		</ol>
	</section>

	<section>
		<div class="section-head">
			<p class="section-num">04 · Questions</p>
			<h2 class="section-title">A few answers</h2>
		</div>
		<dl class="faq">
			{
				content.faq.map((item) => (
					<div class="faq-pair">
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))
			}
		</dl>
		<p class="faq-tail">
			The human side is on the <a href="/about">about</a> page. The stack is on
			<a href="/technology">technology</a>.
		</p>
	</section>
</Layout>

<script>
	(function () {
		const gallery = document.querySelector("[data-gallery]");
		if (!gallery) return;
		const frame = gallery.querySelector(".gallery-frame");
		const panels = Array.prototype.slice.call(
			gallery.querySelectorAll(".gallery-panel"),
		);
		const tabs = Array.prototype.slice.call(
			gallery.querySelectorAll(".gallery-tabs button"),
		);
		const title = gallery.querySelector("[data-gallery-title]");
		const line = gallery.querySelector("[data-gallery-line]");
		let index = 0;
		let timer: number | null = null;
		let transitionTimer: number | null = null;
		const reduceMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		if (panels.length === 0) return;
		if (panels.length === 1) {
			panels[0].classList.add("is-active");
			panels[0].setAttribute("aria-hidden", "false");
			if (title) title.textContent = panels[0].dataset.title || "";
			if (line) line.textContent = panels[0].dataset.line || "";
			tabs.forEach(function (t) {
				t.classList.add("is-active");
				t.setAttribute("aria-pressed", "true");
			});
			return;
		}

		if (panels.length > 0 && title) {
			title.textContent = panels[0].dataset.title || "";
			if (line) line.textContent = panels[0].dataset.line || "";
		}

		function activate(next: number) {
			if (next === index) return;
			const previous = index;
			const direction = (next - previous + panels.length) % panels.length;
			(gallery as HTMLElement).dataset.direction =
				direction > panels.length / 2 ? "prev" : "next";
			if (transitionTimer) window.clearTimeout(transitionTimer);
			panels.forEach(function (p) {
				p.classList.remove("was-active");
			});
			const outgoing = panels[previous];
			if (outgoing) outgoing.classList.add("was-active");
			gallery.classList.add("is-switching");
			transitionTimer = window.setTimeout(function () {
				gallery.classList.remove("is-switching");
				if (outgoing) outgoing.classList.remove("was-active");
				transitionTimer = null;
			}, 920);
			index = next;
			panels.forEach(function (p, i) {
				const active = i === index;
				p.classList.toggle("is-active", active);
				p.setAttribute("aria-hidden", active ? "false" : "true");
			});
			tabs.forEach(function (t, i) {
				const active = i === index;
				t.classList.toggle("is-active", active);
				t.setAttribute("aria-pressed", active ? "true" : "false");
			});
			if (title) title.textContent = panels[index].dataset.title || "";
			if (line) line.textContent = panels[index].dataset.line || "";
		}

		function start() {
			if (reduceMotion || timer) return;
			timer = window.setInterval(function () {
				activate((index + 1) % panels.length);
			}, 4500);
		}
		function stop() {
			if (!timer) return;
			window.clearInterval(timer);
			timer = null;
		}

		tabs.forEach(function (tab, i) {
			tab.addEventListener("click", function () {
				stop();
				activate(i);
				start();
			});
		});
		if (frame) {
			frame.addEventListener("click", function (e) {
				const box = frame.getBoundingClientRect();
				const next =
					(e as MouseEvent).clientX < box.left + box.width / 2
						? (index - 1 + panels.length) % panels.length
						: (index + 1) % panels.length;
				stop();
				activate(next);
				start();
			});
		}
		gallery.addEventListener("mouseenter", stop);
		gallery.addEventListener("mouseleave", start);
		gallery.addEventListener("focusin", stop);
		gallery.addEventListener("focusout", start);
		start();
	})();
</script>
