---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import PortfolioCard from "../components/PortfolioCard.astro";
import { galleryPortfolios, portfolios } from "../data/portfolios";
import ir from "../../content.json";

const { content } = ir;
const title = "Dinsor · Art and science share a bench";
const description =
	"Studio of Dinsor (Stephen Harrison) in Bangkok. Photography, furniture, and open source tools.";
const [enName, thName] = content.product_name.split(" / ");
---

<Layout title={title} description={description}>
	<section class="section hero" aria-labelledby="page-title">
		<p class="overline">Studio · Bangkok</p>
		<h1 id="page-title" class="display">
			{thName ? (
				<>
					<span class="hero-en">{enName}</span>
					<span class="hero-slash"> / </span>
					<span class="hero-th">{thName}</span>
				</>
			) : (
				content.product_name
			)}
		</h1>
		<p class="lede">{content.tagline}</p>
		<div class="row">
			<span class="tag quiet">Open source</span>
			<span class="tag quiet">Hand-built</span>
			<span class="tag quiet">Free to use</span>
		</div>
	</section>

	<section class="section" aria-labelledby="see-title">
		<div class="section-head">
			<p class="overline">00 · See it</p>
			<h2 id="see-title">Shipped sites</h2>
			<p class="lede">Real screens. Four of them.</p>
		</div>
		<div class="gallery" data-gallery>
			<div class="gallery-frame" aria-live="polite">
				{
					galleryPortfolios.map((portfolio, i) => (
						<a
							class:list={["gallery-panel", i === 0 && "is-active"]}
							href={portfolio.url}
							target="_blank"
							rel="noopener noreferrer"
							data-title={portfolio.title}
							data-line={portfolio.galleryCaption}
							aria-hidden={i === 0 ? "false" : "true"}
							tabindex={i === 0 ? undefined : -1}
						>
							<Image
								src={portfolio.image}
								alt={portfolio.title}
								width={1040}
								height={650}
								widths={[640, 1040, 1560]}
								sizes="(min-width: 1104px) 1040px, calc(100vw - 40px)"
								fit="cover"
								position="top"
								format="webp"
								loading={i === 0 ? "eager" : "lazy"}
							/>
						</a>
					))
				}
			</div>
			<div class="gallery-caption">
				<p class="title" data-gallery-title></p>
				<p class="line" data-gallery-line></p>
			</div>
			<div class="gallery-tabs" aria-label="Choose a screenshot">
				{
					galleryPortfolios.map((portfolio, i) => (
						<button
							type="button"
							class:list={["btn", i === 0 && "is-active"]}
							aria-pressed={i === 0 ? "true" : "false"}
						>
							{portfolio.title}
						</button>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" id="works" aria-labelledby="works-title">
		<div class="section-head">
			<p class="overline">01 · Selected works</p>
			<h2 id="works-title">The full bench</h2>
			<p class="lede">Every public site, in one grid.</p>
		</div>
		<div class="demo-grid">
			{portfolios.map((portfolio) => <PortfolioCard portfolio={portfolio} />)}
		</div>
	</section>

	<section class="section" aria-labelledby="s02-title">
		<div class="section-head">
			<p class="overline">02 · Practice</p>
			<h2 id="s02-title">What the work is</h2>
		</div>
		<ol class="features">
			{
				content.features.map((feature) => (
					<li>
						<p class="name">
							{feature.name}
							<small>{feature.subtitle}</small>
						</p>
						<p class="what">{feature.description}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="section" aria-labelledby="s03-title">
		<div class="section-head">
			<p class="overline">03 · Principles</p>
			<h2 id="s03-title">How it gets built</h2>
		</div>
		<ol class="principles">
			{
				content.principles.map((principle, i) => (
					<li>
						<span class="n">{i + 1}</span>
						<span class="body">
							<b>{principle.title}</b>
							<span>{principle.description}</span>
						</span>
					</li>
				))
			}
		</ol>
	</section>

	<section class="section" aria-labelledby="s04-title">
		<div class="section-head">
			<p class="overline">04 · Questions</p>
			<h2 id="s04-title">A few answers</h2>
		</div>
		<dl class="faq">
			{
				content.faq.map((item) => (
					<div class="faq-pair">
						<dt>{item.q}</dt>
						<dd>{item.a}</dd>
					</div>
				))
			}
		</dl>
		<p class="faq-tail">
			The human side is on the <a href="/about">about</a> page. The stack is on
			<a href="/technology">technology</a>.
		</p>
	</section>
</Layout>

<script>
	const gallery = document.querySelector<HTMLElement>("[data-gallery]");

	if (gallery) {
		const panels = Array.from(gallery.querySelectorAll<HTMLElement>(".gallery-panel"));
		const tabs = Array.from(gallery.querySelectorAll<HTMLButtonElement>(".gallery-tabs button"));
		const title = gallery.querySelector("[data-gallery-title]");
		const line = gallery.querySelector("[data-gallery-line]");

		function show(index: number) {
			panels.forEach((panel, i) => {
				const active = i === index;
				panel.classList.toggle("is-active", active);
				panel.setAttribute("aria-hidden", active ? "false" : "true");
				if (active) panel.removeAttribute("tabindex");
				else panel.setAttribute("tabindex", "-1");
			});
			tabs.forEach((tab, i) => {
				const active = i === index;
				tab.classList.toggle("is-active", active);
				tab.setAttribute("aria-pressed", active ? "true" : "false");
			});
			if (title) title.textContent = panels[index]?.dataset.title ?? "";
			if (line) line.textContent = panels[index]?.dataset.line ?? "";
		}

		tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i)));
		show(0);
	}
</script>
