---
import '../styles/globals.css';
import ChatModal from '../components/ChatModal.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Dinsor",
	description = "Portfolio and creative works of Dinsor (Stephen Harrison) in Bangkok.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://dinsor.org").href;
const ogImage = new URL("/images/dinsor.jpg", Astro.site ?? "https://dinsor.org").href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Stephen Harrison",
			"alternateName": "Dinsor",
			"url": "https://dinsor.org",
			"email": "dinsor@dinsor.org",
			"jobTitle": "Builder",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Bangkok",
				"addressCountry": "TH",
			},
			"sameAs": [
				"https://github.com/cloudy-native",
				"https://th.linkedin.com/in/stephenharrison",
			],
		})} />
	</head>
	<body>
		<main class="page">
			<slot />
			<footer class="foot">
				<div class="mark">
					<img src="/images/dinsor.jpg" alt="Dinsor" />
					<span class="wm-name">Dinsor</span>
					<span class="wm-line">Stephen Harrison · Bangkok</span>
				</div>
				<div class="colophon">
					<div class="links">
						<a href="/about">About</a> &middot;
						<a href="/technology">Technology</a> &middot;
						<a href="mailto:dinsor@dinsor.org">Email</a> &middot;
						<a href="https://github.com/cloudy-native" target="_blank" rel="noopener noreferrer">GitHub</a> &middot;
						<a href="https://th.linkedin.com/in/stephenharrison" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					</div>
					<p class="ethos">A pencil is for ideas on the go.</p>
				</div>
			</footer>
		</main>
		<ChatModal />
	</body>
</html>
